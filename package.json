{
  "name": "vera-voice-agent",
  "version": "1.0.0",
  "description": "AI Voice Agent for E-Commerce Order Processing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node scripts/seed.ts",
    "seed:clear": "ts-node scripts/seed.ts --clear",
    "test": "tsx --test src/__tests__/session.test.ts",
    "lint": "tsc --noEmit",
    "create-assistant": "ts-node scripts/create-assistant.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "stripe": "^16.5.0",
    "uuid": "^9.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
